#!/usr/bin/env bash
# Pre-commit guard: format, lint, type-check and test before every commit, so
# a commit cannot land with a failing test or an unformatted file (both
# happened on 2026-09-15 when a pipe hid an exit status). Installed by
# ops/install-hooks (sets core.hooksPath); skip once with `git commit -n`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export PATH="${HOME}/.local/bin:${PATH}"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
py=$(echo "$staged" | grep -E '\.py$' || true)
if [[ -n "$py" ]]; then
  # shellcheck disable=SC2086
  uv run ruff format --check $py || { echo "pre-commit: run 'uv run ruff format' and re-stage" >&2; exit 1; }
  # shellcheck disable=SC2086
  uv run ruff check $py
  uv run mypy
  uv run pytest -q -x
fi
sh=$(echo "$staged" | grep -E '^(scripts|ops)/' | while read -r f; do head -1 "$f" 2>/dev/null | grep -q '^#!.*bash' && echo "$f"; done || true)
for f in $sh; do bash -n "$f"; done
exit 0
