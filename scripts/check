#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
# MORPHOLOG_BIN, when set, names the binary (as it does for the generated
# client), so a version installed beside the PATH one can be run alone.
morpholog() { command "${MORPHOLOG_BIN:-morpholog}" "$@"; }

uv run ruff check .
uv run ruff format --check .
uv run pytest
uv run mypy
scripts/check-runner-types
scripts/check-rules
scripts/verify-proofs
scripts/check-programmes

# The vendored typed client must be byte-identical to what the pinned
# binary generates from the v2 programme — drift is a hard failure.
morpholog generate python-client morpholog/research-v2-draft.morph --out src --check
