#!/usr/bin/env bash
# Control tests for the v2 draft programme: prove the locks actually lock.
#
# Runs against a FRESH DISPOSABLE database (never the production record):
# 1. replays morpholog/controls/setup.ndjson — every row must commit;
# 2. replays morpholog/controls/violations.ndjson — every row must be
#    REJECTED, and the refusing `rule` must match expected-rules.json
#    exactly (assertions key on the stable `rule` field, never on prose).
#
# {SESSION_USER} in the setup batch is substituted with the connection's
# actual session_user so the ActorAssertionAuthority claims bind to the
# role actually running the test.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"

# Which draft programme to control-test: v2 (default) or v3. Each has its
# own controls directory; both run against the same fresh database.
VERSION="${1:-v2}"
case "$VERSION" in
  v2) PROGRAMME=morpholog/research-v2-draft.morph; CONTROLS_DIR=morpholog/controls ;;
  v3) PROGRAMME=morpholog/research-v3-draft.morph; CONTROLS_DIR=morpholog/controls-v3 ;;
  *) echo "check-controls: unknown version '$VERSION' (v2|v3)" >&2; exit 2 ;;
esac

CONTROLS_URL="${CONTROLS_DATABASE_URL:-postgres:///grid_mysteries_controls}"
if [[ -z "${CONTROLS_DATABASE_URL:-}" ]]; then
  createdb grid_mysteries_controls 2>/dev/null || true
fi

session_user=$(psql "$CONTROLS_URL" -tAc "select session_user")
echo "== controls: fresh database (session_user=${session_user})"
morpholog init --database-url "$CONTROLS_URL" --reset --i-know-this-deletes-data >/dev/null

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
sed "s/{SESSION_USER}/${session_user}/g" "$CONTROLS_DIR/setup.ndjson" > "$workdir/setup.ndjson"

echo "== setup batch: every row must commit"
morpholog propose "$PROGRAMME" --batch "$workdir/setup.ndjson" \
  --database-url "$CONTROLS_URL" \
  | python3 scripts/receipts.py all-committed 'controls setup: not every row committed'

echo "== violations batch: every row must be refused by its named rule"
morpholog propose "$PROGRAMME" --batch "$CONTROLS_DIR/violations.ndjson" \
  --database-url "$CONTROLS_URL" \
  | python3 scripts/receipts.py rules "$CONTROLS_DIR/expected-rules.json"

echo "check-controls ($VERSION): OK"
