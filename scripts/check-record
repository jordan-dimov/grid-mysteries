#!/usr/bin/env bash
# Two checks the governed record deserves and did not have.
#
# 1. DRIFT: the repo's batches must account for every claim in the live
#    database. scripts/record keeps them together; proposing directly
#    does not, and that has silently happened twice. replay-research
#    catches it, but only in CI (v2 replay needs a disposable cluster),
#    so locally there was no detection at all. This is the local one.
#
# 2. METRIC PROVENANCE: RESEARCH-V2-DESIGN.md says "CI recomputes
#    metrics from artefacts and refuses drift". Nothing did. Each
#    investigation now declares evidence/metric-sources.json mapping a
#    governed metric_name to the evidence file and JSON path it came
#    from, plus the declared relation to that value (exact, or rounded
#    to a stated quantum). A governed number nobody can trace back to a
#    file is exactly the hole EvidenceMetric exists to close.
#
# Needs DATABASE_URL. Read-only: proposes nothing, writes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
exec uv run python - "$@" <<'PY'
import json, os, subprocess, sys
from decimal import Decimal
from pathlib import Path

url = os.environ.get("DATABASE_URL")
if not url:
    raise SystemExit("check-record: DATABASE_URL is unset")
claims = json.loads(
    subprocess.run(["morpholog", "inspect", "claims", "--database-url", url],
                   capture_output=True, text=True, check=True).stdout
)

# ---- 1. repo/database drift -------------------------------------------------
batch_rows = 0
for batch in sorted(Path("morpholog/batches").glob("*.ndjson")):
    batch_rows += sum(1 for line in batch.read_text().splitlines() if line.strip())
transitions = int(subprocess.run(
    ["psql", url, "-tAc", "select count(*) from morpholog.audit"],
    capture_output=True, text=True, check=True).stdout.strip())
print(f"repo batches: {batch_rows} rows   database transitions: {transitions}")
if batch_rows != transitions:
    raise SystemExit(
        f"DRIFT: {transitions - batch_rows} transition(s) in the database are not in the "
        "repo batches. Something was proposed outside scripts/record; append the row(s) "
        "in the order they happened and re-export claims/anchor/pack."
    )
print("   no drift: every committed transition is accounted for in the repo")

# ---- 2. metric provenance ---------------------------------------------------
governed = {}
for claim in claims:
    if claim["predicate"] == "EvidenceMetric":
        args = [a["value"] for a in claim["args"]]
        governed[(args[1], args[3])] = Decimal(args[4])

def resolve(document, path: str):
    node = document
    for step in path.split("."):
        node = node[int(step)] if step.lstrip("-").isdigit() else node[step]
    return Decimal(str(node))

checked = failures = untraced = 0
metric_specs = sorted(Path("investigations").glob("*/evidence/metric-sources.json"))
metric_specs += sorted(Path("investigations").glob("*/*/evidence/metric-sources.json"))
for sources in metric_specs:
    spec = json.loads(sources.read_text())
    inquiry = spec["inquiry"]
    for name, rule in spec["metrics"].items():
        key = (inquiry, name)
        if key not in governed:
            print(f"   ?  {inquiry}/{name}: declared source but no governed metric")
            untraced += 1
            continue
        document = json.loads((sources.parent / rule["file"]).read_text())
        value = resolve(document, rule["path"])
        if "minus_path" in rule:
            value -= resolve(document, rule["minus_path"])
        relation = rule.get("relation", "exact")
        ok = value == governed[key] if relation == "exact" else (
            value.quantize(Decimal(rule["quantum"])) == governed[key]
        )
        checked += 1
        if not ok:
            failures += 1
            print(f"   !! {inquiry}/{name}: governed {governed[key]}, evidence {value} "
                  f"({relation})")
untraced += len(governed) - checked
print(f"metric provenance: {checked} checked, {failures} mismatched, "
      f"{len(governed) - checked} governed metric(s) with no declared source")
if failures:
    raise SystemExit("check-record: a governed metric does not match its evidence")

# ---- 3. sealed declarations still exist, byte for byte --------------------
import hashlib

sealed = {}
for claim in claims:
    if claim["predicate"] == "ProtocolDeclared":
        args = [a["value"] for a in claim["args"]]
        sealed[args[0]] = args[1]
# v3: a Declaration's content_digest is sealed by DeclarationSealed; the
# same recoverability rule applies to generator protocols, batch files,
# kill tests and study declarations.
v3_declared = {}
v3_sealed = set()
for claim in claims:
    args = [a["value"] for a in claim["args"]]
    if claim["predicate"] == "Declaration":
        v3_declared[args[0]] = args[3]
    elif claim["predicate"] == "DeclarationSealed":
        v3_sealed.add(args[0])
for declaration in sorted(v3_sealed):
    sealed[declaration] = v3_declared[declaration]
on_disk = {}
# Every frozen declaration anywhere under investigations/: forensic
# (DECLARATION-as-sealed.md), forward (F*/DECLARATION.md) and the newer
# top-level DECLARATION.md form. A narrower glob silently exempted 005.
# v3 seals more than DECLARATION files: generator protocols, batch files
# and the F001 stage test are frozen artefacts too.
declarations = list(Path("investigations").rglob("*DECLARATION*.md"))
declarations += list(Path("investigations").rglob("BATCH-*.md"))
declarations += list(Path("investigations").rglob("CANDIDATE-PROTOCOL*.md"))
declarations += list(Path("investigations").rglob("STAGE-TEST*.md"))
for candidate in declarations:
    on_disk[hashlib.sha256(candidate.read_bytes()).hexdigest()] = candidate
missing = {i: d for i, d in sealed.items() if d not in on_disk}
for inquiry, digest in sorted(sealed.items()):
    where = on_disk.get(digest)
    print(f"   {'ok' if where else '!!'} {inquiry}: {digest[:16]}… "
          f"{where if where else 'NO FILE ON DISK HASHES TO THIS'}")
if missing:
    raise SystemExit(
        "check-record: a sealed protocol digest matches no file on disk. The frozen "
        "declaration must remain recoverable byte for byte, or 'the rules were frozen "
        "before the data was seen' cannot be checked by anyone."
    )
print(f"sealed declarations: {len(sealed)} verified against files on disk")

# ---- 4. dated watches: an overdue watch with no reading is a broken promise
from datetime import date

watches = {}
readings = set()
for claim in claims:
    args = [a["value"] for a in claim["args"]]
    if claim["predicate"] == "Watch":
        watches[args[0]] = (args[1], args[2], args[3], date.fromisoformat(str(args[4])[:10]))
    elif claim["predicate"] == "WatchReading":
        readings.add(args[0])
today = date.today()
overdue = {w: v for w, v in watches.items() if v[3] < today and w not in readings}
for watch, (about, observation, holder, due) in sorted(watches.items(), key=lambda kv: kv[1][3]):
    state = "read" if watch in readings else ("OVERDUE" if due < today else "open")
    print(f"   {state:8s} {watch}: {about} — {observation} (held by {holder}, due {due})")
if overdue:
    raise SystemExit(
        f"check-record: {len(overdue)} watch(es) past due with no reading recorded. A dated "
        "resolving observation is an obligation, not a note: record a reading "
        "(outcome resolved / unchanged / not_available) via scripts/record."
    )
print(f"watches: {len(watches)} open, none overdue")
print("check-record: OK")
PY
