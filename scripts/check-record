#!/usr/bin/env bash
# Four checks the governed record deserves: drift, metric provenance, the
# recoverability of every sealed digest, and overdue watches.
#
# 1. DRIFT: the repo's batches must account for every claim in the live
#    database. scripts/record keeps them together; proposing directly
#    does not, and that has silently happened twice. replay-research
#    catches it, but only in CI (v2 replay needs a disposable cluster),
#    so locally there was no detection at all. This is the local one.
#
# 2. METRIC PROVENANCE: RESEARCH-V2-DESIGN.md says "CI recomputes
#    metrics from artefacts and refuses drift". Nothing did. Each
#    investigation now declares evidence/metric-sources.json mapping a
#    governed metric_name to the evidence file and JSON path it came
#    from, plus the declared relation to that value (exact, or rounded
#    to a stated quantum). A governed number nobody can trace back to a
#    file is exactly the hole EvidenceMetric exists to close.
#
# 4. PROVISIONED: the database holds every index and statistics object
#    the three programmes need (`provision indexes --check`, v0.0.14). A
#    programme deployed after a provisioning run is unprovisioned until the
#    step is run again; the Bill record went four days that way.
#
# 5. FIT: each programme still fits the claims the database holds
#    (`check --database-url`, v0.0.16, #575): a stored claim with another
#    arity, kind or unit than its declaration is an error no rule could
#    match. The two siblings are named with `--against`, so a predicate
#    one of them declares is not reported as undeclared, and a predicate
#    two of them write is. No hint is expected: since 21/10/2026 only v1
#    registers a signing key (v2's act was dropped by amendment, Morpholog's
#    shared-writer lint having named the laxer gate as the one that decides
#    which keys checkpoints trust).
#
# Needs DATABASE_URL. Read-only: proposes nothing, writes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
# MORPHOLOG_BIN, when set, names the binary (as it does for the generated
# client), so a version installed beside the PATH one can be run alone.
morpholog() { command "${MORPHOLOG_BIN:-morpholog}" "$@"; }
echo "== provisioning (every programme the record serves, one call)"
morpholog provision indexes morpholog/research.morph morpholog/research-v2-draft.morph \
  morpholog/research-v3-draft.morph --check --database-url "${DATABASE_URL:?check-record: DATABASE_URL is unset}" >/dev/null \
  || { echo "check-record: the database is not provisioned for its programmes; run" >&2
       echo "  morpholog provision indexes morpholog/research.morph morpholog/research-v2-draft.morph morpholog/research-v3-draft.morph --prune" >&2
       exit 1; }
echo "   provisioned and current"
echo "== fit (each programme against the claims the record holds, its siblings named)"
PROGRAMMES=(morpholog/research.morph morpholog/research-v2-draft.morph morpholog/research-v3-draft.morph)
for programme in "${PROGRAMMES[@]}"; do
  against=()
  for sibling in "${PROGRAMMES[@]}"; do
    [[ "$sibling" == "$programme" ]] || against+=(--against "$sibling")
  done
  morpholog check "$programme" "${against[@]}" --database-url "$DATABASE_URL" \
    || { echo "check-record: $programme no longer fits the claims the record holds (see above)" >&2
         exit 1; }
done
echo "   every programme fits the stored claims"
exec uv run python - "$@" <<'PY'
import json, os, subprocess, sys
from decimal import Decimal
from pathlib import Path

url = os.environ.get("DATABASE_URL")
if not url:
    raise SystemExit("check-record: DATABASE_URL is unset")
claims = json.loads(
    subprocess.run([os.environ.get("MORPHOLOG_BIN", "morpholog"), "inspect", "claims", "--database-url", url],
                   capture_output=True, text=True, check=True).stdout
)

# ---- 1. repo/database drift -------------------------------------------------
batch_rows = 0
for batch in sorted(Path("morpholog/batches").glob("*.ndjson")):
    batch_rows += sum(1 for line in batch.read_text().splitlines() if line.strip())
# BRIDGE: this counts rows of Morpholog's own audit table with psql, a read the
# kernel does not pin. It stays until a read-only `audit head` ships (Morpholog
# issue 584); replace it with that read the day it arrives.
transitions = int(subprocess.run(
    ["psql", url, "-tAc", "select count(*) from morpholog.audit"],
    capture_output=True, text=True, check=True).stdout.strip())
print(f"repo batches: {batch_rows} rows   database transitions: {transitions}")
if batch_rows != transitions:
    raise SystemExit(
        f"DRIFT: {transitions - batch_rows} transition(s) in the database are not in the "
        "repo batches. Something was proposed outside scripts/record; append the row(s) "
        "in the order they happened and re-export claims/anchor/pack."
    )
print("   no drift: every committed transition is accounted for in the repo")

# ---- 2. metric provenance ---------------------------------------------------
governed = {}
for claim in claims:
    if claim["predicate"] == "EvidenceMetric":
        args = [a["value"] for a in claim["args"]]
        governed[(args[1], args[3])] = Decimal(args[4])

def resolve(document, path: str):
    node = document
    for step in path.split("."):
        node = node[int(step)] if step.lstrip("-").isdigit() else node[step]
    return Decimal(str(node))

checked = failures = 0
metric_specs = sorted(Path("investigations").glob("*/evidence/metric-sources.json"))
metric_specs += sorted(Path("investigations").glob("*/*/evidence/metric-sources.json"))
for sources in metric_specs:
    spec = json.loads(sources.read_text())
    inquiry = spec["inquiry"]
    for name, rule in spec["metrics"].items():
        key = (inquiry, name)
        if key not in governed:
            print(f"   ?  {inquiry}/{name}: declared source but no governed metric")
            continue
        document = json.loads((sources.parent / rule["file"]).read_text())
        value = resolve(document, rule["path"])
        if "minus_path" in rule:
            value -= resolve(document, rule["minus_path"])
        relation = rule.get("relation", "exact")
        ok = value == governed[key] if relation == "exact" else (
            value.quantize(Decimal(rule["quantum"])) == governed[key]
        )
        checked += 1
        if not ok:
            failures += 1
            print(f"   !! {inquiry}/{name}: governed {governed[key]}, evidence {value} "
                  f"({relation})")
print(f"metric provenance: {checked} checked, {failures} mismatched, "
      f"{len(governed) - checked} governed metric(s) with no declared source")
if failures:
    raise SystemExit("check-record: a governed metric does not match its evidence")

# ---- 3. sealed declarations still exist, byte for byte --------------------
import hashlib

sealed = {}
for claim in claims:
    if claim["predicate"] == "ProtocolDeclared":
        args = [a["value"] for a in claim["args"]]
        sealed[args[0]] = args[1]
# v3: a Declaration's content_digest is sealed by DeclarationSealed; the
# same recoverability rule applies to generator protocols, batch files,
# kill tests and study declarations.
v3_declared = {}
v3_sealed = set()
for claim in claims:
    args = [a["value"] for a in claim["args"]]
    if claim["predicate"] == "Declaration":
        v3_declared[args[0]] = args[3]
    elif claim["predicate"] == "DeclarationSealed":
        v3_sealed.add(args[0])
for declaration in sorted(v3_sealed):
    sealed[declaration] = v3_declared[declaration]
on_disk = {}
# Every frozen declaration anywhere under investigations/: forensic
# (DECLARATION-as-sealed.md), forward (F*/DECLARATION.md) and the newer
# top-level DECLARATION.md form. A narrower glob silently exempted 005.
# v3 seals more than DECLARATION files: generator protocols, batch files
# and the F001 stage test are frozen artefacts too.
declarations = list(Path("investigations").rglob("*DECLARATION*.md"))
declarations += list(Path("investigations").rglob("BATCH-*.md"))
declarations += list(Path("investigations").rglob("CANDIDATE-PROTOCOL*.md"))
declarations += list(Path("investigations").rglob("STAGE-TEST*.md"))
# Forensic amendments frozen under their own names (013, 018, 022) and 022's
# acquisition protocol, sealed in v3 from 12/10/2026 (launch-forensic/).
declarations += list(Path("investigations").rglob("AMENDMENT-*.md"))
declarations += list(Path("investigations").rglob("ACQUISITION*.md"))
for candidate in declarations:
    on_disk[hashlib.sha256(candidate.read_bytes()).hexdigest()] = candidate
missing = {i: d for i, d in sealed.items() if d not in on_disk}
for inquiry, digest in sorted(sealed.items()):
    where = on_disk.get(digest)
    print(f"   {'ok' if where else '!!'} {inquiry}: {digest[:16]}… "
          f"{where if where else 'NO FILE ON DISK HASHES TO THIS'}")
if missing:
    raise SystemExit(
        "check-record: a sealed protocol digest matches no file on disk. The frozen "
        "declaration must remain recoverable byte for byte, or 'the rules were frozen "
        "before the data was seen' cannot be checked by anyone."
    )
print(f"sealed declarations: {len(sealed)} verified against files on disk")

# ---- 4. dated watches: a lapse the record admits, never one a script hides
# A watch past due with no reading is a lapse the v3 programme itself admits
# (`sweep_watch`, 21/10/2026): an outside sweep hands the kernel the date and
# the programme's own rule decides. This block asks the kernel, never the
# calendar. For each watch with no reading and no Lapsed claim it asks
# `morpholog explain sweep_watch(watch, today)` (nothing recorded) whether a
# sweep would commit: admissible means the lapse exists and nobody has swept
# it; sweep_due_has_passed means the watch is still open. A Lapsed claim with
# no reading is a lapse awaiting its reading. Both states fail the check.
from datetime import date

MORPHOLOG = os.environ.get("MORPHOLOG_BIN", "morpholog")
V3 = "morpholog/research-v3-draft.morph"
watches, readings, lapsed = {}, set(), {}
for claim in claims:
    args = [a["value"] for a in claim["args"]]
    if claim["predicate"] == "Watch":
        watches[args[0]] = (args[1], args[2], args[3], date.fromisoformat(str(args[4])[:10]))
    elif claim["predicate"] == "WatchReading":
        readings.add(args[0])
    elif claim["predicate"] == "Lapsed":
        lapsed[args[0]] = str(args[1])[:10]
today = date.today().isoformat()


def sweep_verdict(watch: str) -> str:
    """`admissible`, or the rule the kernel would refuse a sweep of this watch by."""
    out = subprocess.run(
        [MORPHOLOG, "explain", V3, "sweep_watch", "--actor", "claude_fable_5",
         "--args-named", json.dumps({"watch": watch, "as_of": today}),
         "--database-url", url, "--json"],
        capture_output=True, text=True, check=True).stdout
    verdict = json.loads(out)["verdict"]
    return "admissible" if verdict == "admissible" else str(verdict["rejected"].get("rule"))


unswept, unread = [], []
for watch, (about, observation, holder, due) in sorted(watches.items(), key=lambda kv: kv[1][3]):
    if watch in readings:
        state = "read"
    elif watch in lapsed:
        state = f"LAPSED {lapsed[watch]}"
        unread.append(watch)
    else:
        verdict = sweep_verdict(watch)
        if verdict == "admissible":
            state = "UNSWEPT"
            unswept.append(watch)
        elif verdict == "sweep_due_has_passed":
            state = "open"
        else:
            raise SystemExit(f"check-record: the kernel would refuse a sweep of {watch} by "
                             f"`{verdict}`, a state this check does not expect")
    print(f"   {state:18s} {watch}: {about} — {observation} (held by {holder}, due {due})")
if unswept:
    raise SystemExit(
        f"check-record: {len(unswept)} watch(es) past due with no reading and not yet swept: "
        "the record does not yet say so. Run scripts/sweep-watches (it records "
        "Lapsed(watch, today) for each), then record a reading via scripts/read-watch."
    )
if unread:
    raise SystemExit(
        f"check-record: {len(unread)} lapsed watch(es) with no reading ({', '.join(unread)}). A "
        "dated resolving observation is an obligation, not a note: record a reading "
        "(outcome resolved / unchanged / not_available) via scripts/read-watch."
    )
print(f"watches: {len(watches)} open, none lapsed, none unswept")
print("check-record: OK")
PY
