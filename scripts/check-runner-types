#!/usr/bin/env bash
# Investigation runners held to the project's mypy settings. Each is checked
# on its own: they are all modules named `run`, which one mypy run refuses.
# A runner joins this list once it is clean and never leaves it (a ratchet);
# the runners not listed had 1 to 6 errors each on 2026-10-28.
#
#   scripts/check-runner-types            every listed runner (scripts/check)
#   scripts/check-runner-types FILE...    the listed ones among FILE (pre-commit)
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
typed=(
  investigations/013-the-cover-price-tracker/run.py
  investigations/016-day-ahead-wind-forecast/run.py
  investigations/020-did-it-energise/run.py
  investigations/025-the-exit-clock/run.py
)
targets=()
if [[ $# -eq 0 ]]; then
  targets=("${typed[@]}")
else
  for f in "$@"; do
    for t in "${typed[@]}"; do [[ "$f" == "$t" ]] && targets+=("$t"); done
  done
fi
for f in "${targets[@]}"; do
  uv run mypy --no-error-summary "$f" || { echo "check-runner-types: $f" >&2; exit 1; }
done
[[ $# -eq 0 ]] && echo "check-runner-types: ${#typed[@]} runner(s) clean"
exit 0
