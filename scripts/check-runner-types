#!/usr/bin/env bash
# Every investigation runner held to the project's mypy settings. Each is
# checked on its own: they are all modules named `run`, which one mypy run
# refuses. All nineteen were brought clean on 2026-10-28 (annotations, and
# `main()` for `sys.exit(main())` where main returns None); a new runner is
# clean from its first commit.
#
#   scripts/check-runner-types            every runner (scripts/check)
#   scripts/check-runner-types FILE...    the runners among FILE (pre-commit)
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
typed=(investigations/*/run.py)
targets=()
if [[ $# -eq 0 ]]; then
  targets=("${typed[@]}")
else
  for f in "$@"; do
    for t in "${typed[@]}"; do [[ "$f" == "$t" ]] && targets+=("$t"); done
  done
fi
for f in "${targets[@]}"; do
  uv run mypy --no-error-summary "$f" || { echo "check-runner-types: $f" >&2; exit 1; }
done
[[ $# -eq 0 ]] && echo "check-runner-types: ${#typed[@]} runner(s) clean"
exit 0
