#!/usr/bin/env bash
# The laptop watchdog (ops/VINTAGE-CAPTURE.md, section 7): five checks on
# the vintage archive and one sync into the repository. Run by the systemd
# user timer in ops/systemd/, or by hand. Read-only against the bucket (the
# watchdog credential cannot write); writes only under data/manifests/,
# data/raw/archive/ and synced instrument state in the repo.
#
#   scripts/check-vintages [--include-bytes]
#
# Environment: VINTAGE_STORE (default s3://a115-vintages), AWS_PROFILE
# (default a115-watchdog), HEALTHCHECK_URL_WATCHDOG (optional). Failures go
# to the log, to notify-send, to the healthcheck when one is configured, and
# to the exit status.
#
# notify-send is not an alarm. Under the systemd user timer it reaches no
# desktop bus, and this watchdog failed silently on three consecutive runs
# (2026-09-16 22:59 BST onward) because the `a115-watchdog` AWS profile had
# gone from ~/.aws/credentials; nothing said so, and the archive stopped
# syncing into the repository unnoticed. Both Render jobs ping healthchecks.io
# and are watched; this one was not. Set HEALTHCHECK_URL_WATCHDOG to a
# healthchecks.io check (twice-daily schedule, generous grace) and it is.
set -uo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
export VINTAGE_STORE="${VINTAGE_STORE:-s3://a115-vintages}"
export AWS_PROFILE="${AWS_PROFILE:-a115-watchdog}"
log=data/vintage-watchdog.log
mkdir -p data
{
  echo "=== $(date -u +%FT%TZ) check-vintages ($VINTAGE_STORE)"
  uv run --group capture grid-mysteries capture check "$@"
  status=$?
  echo "=== exit $status"
} >> "$log" 2>&1
ping() {  # ok|fail — no-op until HEALTHCHECK_URL_WATCHDOG is set
  [[ -n "${HEALTHCHECK_URL_WATCHDOG:-}" ]] || return 0
  local url="$HEALTHCHECK_URL_WATCHDOG"; [[ "$1" == fail ]] && url="${url%/}/fail"
  curl -fsS -m 20 --retry 3 -o /dev/null "$url" || true
}
if [[ ${status:-1} -ne 0 ]]; then
  command -v notify-send >/dev/null && notify-send -u critical "Vintage archive check failed" "see $log"
  ping fail
  exit 1
fi
ping ok
