#!/usr/bin/env bash
set -euo pipefail

VERSION="v0.0.12"
BASE="https://github.com/jordan-dimov/morpholog/releases/download/${VERSION}"

os="$(uname -s)"
arch="$(uname -m)"

case "${os}/${arch}" in
  Linux/x86_64)
    asset="morpholog-${VERSION}-x86_64-unknown-linux-musl.tar.gz"
    expected="964bffac55eeadf51e7b43942f9cd0e3eeb5c0277d133491fd3126f2be72ea4b"
    ;;
  Linux/aarch64|Linux/arm64)
    asset="morpholog-${VERSION}-aarch64-unknown-linux-musl.tar.gz"
    expected="9c65857f07a147c01a26e28a2994b65ea915942fc98fd128d49ea48b63501e5a"
    ;;
  Darwin/arm64)
    asset="morpholog-${VERSION}-aarch64-apple-darwin.tar.gz"
    expected="d48584fa1753b623e2de68c88adeb1356c0b4f2ab5c7ec0266b3a000ceef3d72"
    ;;
  *)
    echo "unsupported platform: ${os}/${arch}" >&2
    echo "install Morpholog ${VERSION} manually and place 'morpholog' on PATH" >&2
    exit 2
    ;;
esac

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl --fail --location --silent --show-error "${BASE}/${asset}" -o "${tmp}/${asset}"
actual="$(if command -v sha256sum >/dev/null; then sha256sum "${tmp}/${asset}" | awk '{print $1}'; else shasum -a 256 "${tmp}/${asset}" | awk '{print $1}'; fi)"
if [[ "$actual" != "$expected" ]]; then
  echo "Morpholog checksum verification failed" >&2
  echo "expected: $expected" >&2
  echo "actual:   $actual" >&2
  exit 1
fi

tar -xzf "${tmp}/${asset}" -C "$tmp"
mkdir -p "${HOME}/.local/bin"
install -m 0755 "$(find "$tmp" -type f -name morpholog -print -quit)" "${HOME}/.local/bin/morpholog"
echo "installed Morpholog ${VERSION} to ${HOME}/.local/bin/morpholog"
