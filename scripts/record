#!/usr/bin/env bash
# The one safe way to extend the governed record.
#
#   scripts/record <batch-file-basename> '<ndjson-proposal-row>'
#
# Proposes the row against the production database ONCE, and only if it
# commits: appends it to morpholog/batches/<basename>, refreshes the
# claims export, records a SIGNED checkpoint, re-exports the evidence
# pack, and verifies everything. Git and PostgreSQL cannot be made
# transactionally atomic, so this is recoverable and fail-loud instead:
# if any step AFTER the committed proposal fails, a recovery marker is
# left at morpholog/.record-recovery and the script exits non-zero.
# NEVER retry a proposal whose outcome is uncertain — inspect the
# marker, confirm state with `morpholog inspect claims`, and finish the
# remaining steps by hand (they are all idempotent re-derivations).
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
export DATABASE_URL="${DATABASE_URL:-postgres:///grid_mysteries_morpholog}"

BATCH_FILE="morpholog/batches/$1"
ROW="$2"
# Programme dispatch by filename: *.v2.ndjson -> v2, *.v3.ndjson -> v3,
# everything else -> v1. One convention, shared with scripts/replay-research,
# so a mixed v1+v2+v3 history stays recordable and replayable.
PROGRAMME=morpholog/research.morph
[[ "$BATCH_FILE" == *.v2.ndjson ]] && PROGRAMME=morpholog/research-v2-draft.morph
[[ "$BATCH_FILE" == *.v3.ndjson ]] && PROGRAMME=morpholog/research-v3-draft.morph
MARKER="morpholog/.record-recovery"
SIGNING_KEY="${AUDIT_SIGNING_KEY:-$HOME/.config/grid-mysteries/audit-signing-2026.pem}"

if [[ -e "$MARKER" ]]; then
  echo "record: recovery marker exists ($MARKER); resolve it before recording" >&2
  exit 1
fi
python3 - "$ROW" <<'EOF'
import json, sys
row = json.loads(sys.argv[1])
assert {"transformation", "actor", "args_named"} <= row.keys(), "row must carry transformation/actor/args_named"
EOF

printf '%s\n' "$ROW" > "$MARKER"
tmp=$(mktemp)
printf '%s\n' "$ROW" > "$tmp"

receipt=$(morpholog propose "$PROGRAMME" --batch "$tmp" --explain-on-reject)
rm -f "$tmp"
# The marker is cleared only on a positive non-commit: a rejection (a
# lawful answer), or an error receipt whose stable `code` the runtime
# documents as "nothing was recorded". `commit_outcome_unknown`, a code
# this script does not know, or a receipt it cannot read all keep it.
outcome=$(printf '%s' "$receipt" | python3 -c "
import json, sys
NOT_COMMITTED = {'actor_assertion_unauthorised', 'duplicate_intent', 'invalid_arguments',
                 'invalid_request', 'kernel_error', 'not_committed', 'serialization_failure',
                 'unknown_transformation'}
try:
    r = json.loads(sys.stdin.readline())
except ValueError:
    r = {}
if r.get('status') == 'committed':
    print('committed')
elif r.get('status') == 'rejected' or (r.get('status') == 'error' and r.get('code') in NOT_COMMITTED):
    print('not-committed')
else:
    print('unknown')
")
if [[ "$outcome" == "not-committed" ]]; then
  rm -f "$MARKER"
  echo "record: proposal was not committed (nothing to clean up):" >&2
  printf '%s\n' "$receipt" >&2
  exit 1
fi
if [[ "$outcome" != "committed" ]]; then
  echo "record: the commit outcome is UNKNOWN; marker left at $MARKER." >&2
  echo "record: read the record (morpholog inspect claims) before anything else:" >&2
  printf '%s\n' "$receipt" >&2
  exit 1
fi

# The proposal is committed; every remaining step must succeed or leave
# the marker in place for manual recovery.
printf '%s\n' "$ROW" >> "$BATCH_FILE"
morpholog inspect claims > morpholog/claims-export.json
# Two RFC 3161 authorities countersign the signed head, the same two that
# witness frozen declarations (scripts/timestamp). Only the head's hash
# leaves the machine. The checkpoint is recorded even if one fails.
WITNESSES=(--witness rfc3161:https://freetsa.org/tsr --witness rfc3161:http://timestamp.digicert.com)
if ! morpholog audit checkpoint --signing-key "$SIGNING_KEY" --key-id audit-2026 "${WITNESSES[@]}" \
    > morpholog/audit-anchor.json; then
  tree_size=$(python3 -c "import json; print(json.load(open('morpholog/audit-anchor.json'))['tree_size'])" 2>/dev/null || echo '<tree_size>')
  echo "record: checkpoint recorded but a timestamp authority failed; marker left at $MARKER." >&2
  echo "record: retry, then finish by hand:" >&2
  echo "  morpholog audit witness --tree-size $tree_size ${WITNESSES[*]} > morpholog/audit-anchor.json" >&2
  echo "  morpholog audit export > morpholog/evidence-pack.ndjson" >&2
  echo "  (verify as below, then rm $MARKER)" >&2
  exit 1
fi
morpholog audit export > morpholog/evidence-pack.ndjson
morpholog audit verify-pack morpholog/evidence-pack.ndjson --anchor-file morpholog/audit-anchor.json \
  --require-signing-key morpholog/trust/audit-2026.pub --require-signatures-from 34 \
  --trusted-tsa-file <(cat trust/tsa/freetsa-cacert.pem trust/tsa/digicert-trusted-root-g4.pem) >/dev/null
rm -f "$MARKER"
echo "record: committed and recorded in $BATCH_FILE (remember to commit the morpholog/ changes)"
