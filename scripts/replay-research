#!/usr/bin/env bash
# Rebuild and verify the governed research record from the repository alone.
#
# 1. The programme fingerprint must match the pinned PROGRAMME_HASH.json.
# 2. The committed evidence pack must verify OFFLINE against the committed
#    anchor (no database consulted) — this is the third-party check.
# 3. The checked-in proposal batches replay into a fresh database under the
#    programme's rules; every row must commit.
# 4. The replayed claims must equal the committed claims export.
# 5. The replayed database's audit log must self-verify.
#
# Requires PostgreSQL. Override REPLAY_DATABASE_URL to point elsewhere
# (e.g. a CI service container); by default a local scratch database is
# created. The replay database is DESTROYED AND RECREATED each run.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"

REPLAY_URL="${REPLAY_DATABASE_URL:-postgres:///grid_mysteries_replay}"
if [[ -z "${REPLAY_DATABASE_URL:-}" ]]; then
  createdb grid_mysteries_replay 2>/dev/null || true
fi

echo "== programmes check and hash to their pins"
scripts/check-programmes

echo "== offline evidence-pack verification (no database consulted)"
scripts/verify-research-pack

echo "== governance-attestation check (misconfiguration + naive-forgery control)"
EXPECTED_HUMAN_LOGIN_ROLE="${EXPECTED_HUMAN_LOGIN_ROLE:-gm_human}" uv run python -c "
import os
# attestation.authenticated_by is the session_user Morpholog RECORDS for a
# row it wrote through the runtime path. This check asserts every
# governance/seal/approval row shows the human login. What it catches:
# (1) misconfiguration — a governance row accidentally committed by the
# wrong login through the legit path; (2) a NAIVE substrate forger who
# writes a claim/audit row but does not also fake the attestation. What
# it does NOT catch: the modelled layer-B attacker — gm_machine has raw
# DML on morpholog.audit and nothing binds authenticated_by to the real
# session_user, so a raw INSERT can say 'gm_human' just as easily
# (forced in scripts/rehearse-v2 §H2). Attestation is therefore NOT an
# unforgeable identity assertion against a raw-audit-DML credential. The
# real tamper-evidence against that attacker is the EXTERNALLY-RETAINED
# signed checkpoint over its committed prefix (the signing key is not
# held by the machine) plus claims-vs-audit replay divergence — both
# asserted elsewhere in this script.
from pathlib import Path
from grid_mysteries.record import pack_rows
rows = pack_rows(Path('morpholog/evidence-pack.ndjson'))
expected = os.environ['EXPECTED_HUMAN_LOGIN_ROLE']
governance = {'establish_governance', 'seal_protocol', 'approve_publication'}
checked = 0
for row in rows:
    if row['transformation_name'] in governance:
        who = (row.get('attestation') or {}).get('authenticated_by')
        if who != expected:
            raise SystemExit(
                f'{row[\"transformation_name\"]} {row[\"transition_id\"]} attests login '
                f'{who!r}, not the human role {expected!r} — misconfiguration or naive forgery'
            )
        checked += 1
if not checked:
    raise SystemExit('no governance rows in the pack: the v2 launch rows are missing')
print(f'   {checked} governance rows attest the human login {expected!r} '
      '(not proof against raw-audit-DML; see comment)')
"

echo "== replaying proposal batches into a fresh database"
morpholog init --database-url "$REPLAY_URL" --reset --i-know-this-deletes-data >/dev/null
# v2 and v3 batches share the actor policy (bound to login roles by v2's
# establish_governance) and are replayed together, in order, by the helper.
governed_batches=()
for batch in morpholog/batches/*.ndjson; do
  if [[ "$batch" == *.v2.ndjson || "$batch" == *.v3.ndjson ]]; then
    governed_batches+=("$batch")
    continue
  fi
  echo "   $batch (research.morph)"
  morpholog propose morpholog/research.morph --batch "$batch" --database-url "$REPLAY_URL" \
    | python3 scripts/receipts.py all-committed 'replay: not every proposal committed' '     '
done

# v2 binds each actor to a PostgreSQL login role, so replaying as any other
# role is refused once governance is established. The helper provisions the
# roles the record itself names and proposes each row through the matching
# connection — preserving order, and learning the bindings from the
# committed establish_governance row rather than hardcoding them.
if (( ${#governed_batches[@]} )); then
  for batch in "${governed_batches[@]}"; do echo "   $batch (programme by suffix)"; done
  python3 scripts/replay_v2.py "$REPLAY_URL" "${governed_batches[@]}"
fi

echo "== replayed claims must equal the committed export"
morpholog inspect claims --database-url "$REPLAY_URL" | python3 -c "
import json, sys

def key(claim):
    return (claim['predicate'], tuple(json.dumps(a, sort_keys=True) for a in claim['args']))

replayed = sorted(key(c) for c in json.load(sys.stdin))
committed = sorted(key(c) for c in json.load(open('morpholog/claims-export.json')))
if replayed != committed:
    raise SystemExit('replayed claims differ from morpholog/claims-export.json')
print(f'   {len(replayed)} claims identical')
"

echo "== replayed audit log self-verification"
morpholog audit verify --database-url "$REPLAY_URL"

echo "replay-research: OK"
