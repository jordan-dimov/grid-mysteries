#!/usr/bin/env bash
# Rebuild and verify the governed research record from the repository alone.
#
# 1. The programme fingerprint must match the pinned PROGRAMME_HASH.json.
# 2. The committed evidence pack must verify OFFLINE against the committed
#    anchor (no database consulted) — this is the third-party check.
# 3. The checked-in proposal batches replay into a fresh database under the
#    programme's rules; every row must commit.
# 4. The replayed claims must equal the committed claims export.
# 5. The replayed database's audit log must self-verify.
#
# Requires PostgreSQL. Override REPLAY_DATABASE_URL to point elsewhere
# (e.g. a CI service container); by default a local scratch database is
# created. The replay database is DESTROYED AND RECREATED each run.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"

REPLAY_URL="${REPLAY_DATABASE_URL:-postgres:///grid_mysteries_replay}"
if [[ -z "${REPLAY_DATABASE_URL:-}" ]]; then
  createdb grid_mysteries_replay 2>/dev/null || true
fi

echo "== programme hash"
expected=$(python3 -c "import json; print(json.load(open('morpholog/PROGRAMME_HASH.json'))['hash'])")
actual=$(morpholog hash morpholog/research.morph | python3 -c "import json,sys; print(json.load(sys.stdin)['hash'])")
if [[ "$expected" != "$actual" ]]; then
  echo "programme hash mismatch: pinned $expected, actual $actual" >&2
  exit 1
fi
echo "   $actual"

echo "== offline evidence-pack verification (no database consulted)"
morpholog audit verify-pack morpholog/evidence-pack.json --anchor-file morpholog/audit-anchor.json
python3 -c "
import json
anchor = json.load(open('morpholog/audit-anchor.json'))
signatures = anchor.get('signatures') or []
if not signatures:
    raise SystemExit('current anchor is unsigned; checkpoints must be signed with audit-2026')
# Trust is the REPO-PINNED public key, never the claim set or the key a
# checkpoint carries: v1's key registration predates the authority
# vocabulary and is ungated, so a machine credential could mint a rogue
# AuditSigningKey claim through the retained v1 rules. A rogue key can
# never satisfy this pin.
pinned = open('morpholog/trust/audit-2026.pub').read().strip()
sig = signatures[0]
if sig.get('key_id') != 'audit-2026' or sig.get('public_key') != pinned:
    raise SystemExit(
        f'anchor signed by unpinned key: key_id={sig.get(\"key_id\")!r} — '
        'only the committed morpholog/trust/audit-2026.pub is trusted'
    )
print(f'   anchor signed by the pinned key ({sig[\"key_id\"]})')
"

echo "== genesis attestation (detective control for substrate bypass)"
EXPECTED_HUMAN_LOGIN_ROLE="${EXPECTED_HUMAN_LOGIN_ROLE:-gm_human}" python3 -c "
import json, os
# Every governance/seal/approval transition MUST have been committed by
# the human PostgreSQL login role. attestation.authenticated_by is the
# session_user that actually wrote the row, inside the Merkle leaf — so a
# claim forged AND back-dated with a forged audit row would carry the
# machine's login here, not the human's. Layer-B bypass (see
# V2-LAUNCH-RUNBOOK.md) is thereby provable in the pack forever. No-op
# until the pack contains v2 governance rows.
pack = json.load(open('morpholog/evidence-pack.json'))
expected = os.environ['EXPECTED_HUMAN_LOGIN_ROLE']
governance = {'establish_governance', 'seal_protocol', 'approve_publication'}
checked = 0
for row in pack['rows']:
    if row['transformation_name'] in governance:
        who = (row.get('attestation') or {}).get('authenticated_by')
        if who != expected:
            raise SystemExit(
                f'{row[\"transformation_name\"]} {row[\"transition_id\"]} committed by '
                f'{who!r}, not the human role {expected!r} — substrate forgery suspected'
            )
        checked += 1
print(f'   {checked} governance/seal/approval rows, all committed by {expected!r}'
      if checked else '   no v2 governance rows yet (no-op against the v1 pack)')
"

echo "== replaying proposal batches into a fresh database"
morpholog init --database-url "$REPLAY_URL" --reset --i-know-this-deletes-data >/dev/null
for batch in morpholog/batches/*.ndjson; do
  programme=morpholog/research.morph
  [[ "$batch" == *.v2.ndjson ]] && programme=morpholog/research-v2-draft.morph
  echo "   $batch ($(basename "$programme"))"
  morpholog propose "$programme" --batch "$batch" --database-url "$REPLAY_URL" \
    | python3 -c "
import json, sys
rows = [json.loads(line) for line in sys.stdin if line.strip()]
bad = [row for row in rows if row.get('status') != 'committed']
if bad:
    print(json.dumps(bad, indent=1))
    raise SystemExit('replay: not every proposal committed')
print(f'     {len(rows)} committed')
"
done

echo "== replayed claims must equal the committed export"
morpholog inspect claims --database-url "$REPLAY_URL" | python3 -c "
import json, sys

def key(claim):
    return (claim['predicate'], tuple(json.dumps(a, sort_keys=True) for a in claim['args']))

replayed = sorted(key(c) for c in json.load(sys.stdin))
committed = sorted(key(c) for c in json.load(open('morpholog/claims-export.json')))
if replayed != committed:
    raise SystemExit('replayed claims differ from morpholog/claims-export.json')
print(f'   {len(replayed)} claims identical')
"

echo "== replayed audit log self-verification"
morpholog audit verify --database-url "$REPLAY_URL"

echo "replay-research: OK"
