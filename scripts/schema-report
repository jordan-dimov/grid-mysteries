from pathlib import Path
from grid_mysteries.evidence import write_json
from grid_mysteries.sources import tec_register as tr

root = Path(".")
manifests = sorted((root / "data" / "manifests").glob("*.ndjson"))
vintages = tr.load_capture_copies(manifests, root / "data" / "raw" / "archive")
report = tr.schema_report(vintages, [])
report["archive"] = "neso/tec-register (daily capture)"
for c, (_t, _rows, entry) in zip(report["per_copy"], vintages, strict=True):
    c.update({k: entry[k] for k in ("filename", "key", "manifest", "fetched_at", "t_public_basis")})
out = root / "archives" / "tec-register-capture"
write_json(out / "schema-report.json", report)
L = ["# Schema report: NESO TEC Register, copies held by the daily capture", "",
     "Regenerated by `scripts/schema-report tec-capture`; `schema-report.json` beside this file has every copy. "
     f"{report['copies']} copies, read from the local mirror of the capture archive after each digest was checked "
     "against the daily manifest that recorded it. The date of a copy is its CKAN `last_modified` date, the "
     "convention of every earlier live pin; NESO's filename is shown beside it because it can name another day. "
     "No census figure is computed here.", "",
     "| t_public | NESO filename | captured | manifest | SHA-256 | rows | change | flags |", "|---|---|---|---|---|---|---|---|"]
for c in report["per_copy"]:
    L.append(f"| {c['t_public']} | `{c['filename']}` | {c['fetched_at']} | `{c['manifest']}` | `{c['sha256'][:16]}…` | "
             f"{c['rows']:,} | {c['row_count_change'] or '-'} | {'; '.join(c['flags']) or 'none'} |")
L += ["", "## Eras (one column vocabulary each)", "", "| first | last | copies | columns |", "|---|---|---|---|"]
L += [f"| {e['first']} | {e['last']} | {e['copies']} | {', '.join(e['columns'])} |" for e in report["eras"]]
L += ["", "## Date spellings in the effective-from column, per copy", "",
      "| t_public | " + " | ".join(tr.DATE_SPELLINGS) + " |", "|---" * (len(tr.DATE_SPELLINGS) + 1) + "|"]
L += [f"| {c['t_public']} | " + " | ".join(f"{c['date_spellings'][k]:,}" for k in tr.DATE_SPELLINGS) + " |" for c in report["per_copy"]]
for column, key in tr.VOCABULARY_COLUMNS:
    spellings = list(report[f"{key}_totals"])
    L += ["", f"## {column}, every spelling printed, per copy", "",
          "| t_public | " + " | ".join(s or "(blank)" for s in spellings) + " |", "|---" * (len(spellings) + 1) + "|"]
    L += [f"| {c['t_public']} | " + " | ".join(f"{c[key].get(s, 0):,}" for s in spellings) + " |" for c in report["per_copy"]]
L += ["", "## Blank cells in the required columns, per copy", "",
      "| t_public | " + " | ".join(tr.REQUIRED_COLUMNS) + " |", "|---" * (len(tr.REQUIRED_COLUMNS) + 1) + "|"]
L += [f"| {c['t_public']} | " + " | ".join(f"{c['blank'][k]:,}" for k in tr.REQUIRED_COLUMNS) + " |" for c in report["per_copy"]]
(out / "SCHEMA.md").write_text("\n".join(L) + "\n")
print(f"{report['copies']} captured copies, {len(report['flagged'])} flagged -> archives/tec-register-capture/")
