#!/usr/bin/env bash
# Regenerate an archive's schema report and commit-ready summary:
#   scripts/schema-report tec-register
#   scripts/schema-report csv <file> <archive-name>
#   scripts/schema-report xlsx <file> <archive-name>
# Writes archives/<name>/schema-report.json (every copy's columns, blank
# rates, date spellings, row-count change, flags) and archives/<name>/SCHEMA.md.
# A reader is declared against this report, not against memory of the files.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="${HOME}/.local/bin:${PATH}"
name="${1:-tec-register}"
if [[ "$name" == "csv" ]]; then
  # scripts/schema-report csv <file> <archive-name> [header-line]: one CSV
  # file's columns, row count, blank rates and value forms, for a reader to be
  # declared against. The delimiter is sniffed from the header line (, ; tab |);
  # lines before the header line (1-based, default 1) are recorded as a
  # preamble, and rows that are blank in every column are counted, not read.
  file="${2:?csv file}"; out="${3:?archive name}"; header="${4:-1}"
  mkdir -p "archives/$out"
  exec uv run python - "$file" "$out" "$header" <<'PY2'
import csv, json, re, sys, hashlib
from collections import Counter
from pathlib import Path
from grid_mysteries.evidence import write_json

file, name, header_line = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3])
text = file.read_text(encoding="utf-8-sig", errors="replace")
lines = text.splitlines(keepends=True)
preamble = "".join(lines[: header_line - 1])
body = "".join(lines[header_line - 1 :])
head = lines[header_line - 1] if len(lines) >= header_line else ""
delimiter = max(",;\t|", key=head.count) if head else ","
raw_rows = list(csv.DictReader(body.splitlines(keepends=True), delimiter=delimiter))
blank_rows = [r for r in raw_rows if not any((v or "").strip() for v in r.values() if isinstance(v, str))]
rows = [r for r in raw_rows if r not in blank_rows]
cols = list(rows[0].keys()) if rows else (list(raw_rows[0].keys()) if raw_rows else [])
cols = [c for c in cols if c is not None]
def form(v):
    v = (v or "").strip()
    if not v: return "blank"
    if re.fullmatch(r"-?\d+", v): return "integer"
    if re.fullmatch(r"-?\d+\.\d+", v): return "decimal"
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}.*", v): return "iso-date"
    if re.fullmatch(r"\d{1,2}/\d{1,2}/\d{4}.*", v): return "uk-date"
    return "text"
report = {
    "file": str(file), "sha256": hashlib.sha256(file.read_bytes()).hexdigest(),
    "header_line": header_line, "delimiter": {",": "comma", ";": "semicolon", "\t": "tab", "|": "pipe"}[delimiter],
    "preamble_lines": [l.rstrip("\r\n")[:200] for l in lines[: header_line - 1]],
    "rows": len(rows), "blank_rows_dropped": len(blank_rows), "columns": [],
}
for c in cols:
    values = [r.get(c) or "" for r in rows]
    values = [v if isinstance(v, str) else " ".join(map(str, v)) for v in values]
    forms = Counter(form(v) for v in values)
    distinct = len(set(values))
    sample = [v for v in values if v.strip()][:3]
    report["columns"].append({"name": c, "blank": forms.get("blank", 0), "distinct": distinct,
                              "forms": dict(forms), "sample": sample})
out = Path("archives") / name
write_json(out / "schema-report.json", report)
tidy = lambda v: " ".join(str(v).split())
lines = [f"# Schema report: {name}", "", f"`{file}` (SHA-256 `{report['sha256']}`), {len(rows):,} rows, {len(cols)} columns, "
         f"{report['delimiter']}-delimited, header on line {header_line}, {len(blank_rows):,} blank row(s) dropped. "
         f"Regenerated by `scripts/schema-report csv {file} {name} {header_line}`.", ""]
if report["preamble_lines"]:
    lines += ["Preamble before the header, as printed:", ""] + [f"    {l}" for l in report["preamble_lines"]] + [""]
lines += ["| column | blank | distinct | forms | sample |", "|---|---|---|---|---|"]
for c in report["columns"]:
    lines.append(f"| {tidy(c['name'])} | {c['blank']} | {c['distinct']} | {', '.join(f'{k} {v}' for k, v in c['forms'].items())} | {' / '.join(tidy(s)[:40] for s in c['sample'])} |")
(out / "SCHEMA.md").write_text("\n".join(lines) + "\n")
print(f"{len(rows)} rows, {len(cols)} columns -> archives/{name}/")
PY2
fi
if [[ "$name" == "xlsx" ]]; then
  # scripts/schema-report xlsx <file> <archive-name> [header-row] [sheets]:
  # every sheet of one workbook (or the comma-separated sheets named), the
  # given row (1-based, default 1) as the header, rows above it recorded as a
  # preamble, with row counts, blank rates and value forms per column. Cells
  # are read as typed by openpyxl; nothing is re-spelled; wholly blank rows
  # are counted, not read.
  file="${2:?xlsx file}"; out="${3:?archive name}"; header="${4:-1}"; sheets="${5:-}"
  mkdir -p "archives/$out"
  exec uv run --group registers python - "$file" "$out" "$header" "$sheets" <<'PY3'
import json, re, sys, hashlib
from collections import Counter
from datetime import date, datetime
from pathlib import Path
from openpyxl import load_workbook
from grid_mysteries.evidence import write_json

file, name, header_row = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3])
only = [x for x in sys.argv[4].split(",") if x] if len(sys.argv) > 4 else []
def form(v):
    if v is None or (isinstance(v, str) and not v.strip()): return "blank"
    if isinstance(v, bool): return "bool"
    if isinstance(v, int): return "integer"
    if isinstance(v, float): return "integer" if v.is_integer() else "decimal"
    if isinstance(v, datetime | date): return "date-cell"
    v = str(v).strip()
    if re.fullmatch(r"-?\d+", v): return "integer"
    if re.fullmatch(r"-?\d+\.\d+", v): return "decimal"
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}.*", v): return "iso-date"
    if re.fullmatch(r"\d{1,2}/\d{1,2}/\d{4}.*", v): return "uk-date"
    return "text"
def shown(v):
    return v.isoformat() if isinstance(v, datetime | date) else str(v)
wb = load_workbook(file, read_only=True, data_only=True)
report = {"file": str(file), "sha256": hashlib.sha256(file.read_bytes()).hexdigest(),
          "header_row": header_row, "sheets_all": [ws.title for ws in wb.worksheets], "sheets": []}
for ws in wb.worksheets:
    if only and ws.title not in only:
        continue
    rows = list(ws.iter_rows(values_only=True))
    header = [shown(c) if c is not None else "" for c in (rows[header_row - 1] if len(rows) >= header_row else [])]
    preamble = [[shown(c)[:120] for c in r if c is not None] for r in rows[: header_row - 1]]
    body_all = rows[header_row:]
    body = [r for r in body_all if any(c is not None and str(c).strip() for c in r)]
    sheet = {"name": ws.title, "rows": len(body), "blank_rows_dropped": len(body_all) - len(body),
             "preamble_rows": preamble, "columns": []}
    for i, col in enumerate(header):
        values = [r[i] if i < len(r) else None for r in body]
        forms = Counter(form(v) for v in values)
        sample = [shown(v) for v in values if form(v) != "blank"][:3]
        sheet["columns"].append({"name": col, "blank": forms.get("blank", 0),
                                 "distinct": len({shown(v) if v is not None else "" for v in values}),
                                 "forms": dict(forms), "sample": sample})
    report["sheets"].append(sheet)
out = Path("archives") / name
write_json(out / "schema-report.json", report)
tidy = lambda v: " ".join(str(v).split())
lines = [f"# Schema report: {name}", "", f"`{file}` (SHA-256 `{report['sha256']}`), sheets {', '.join(f'`{t}`' for t in report['sheets_all'])}; "
         f"{len(report['sheets'])} reported, header on row {header_row}. "
         f"Regenerated by `scripts/schema-report xlsx {file} {name} {header_row} '{sys.argv[4] if len(sys.argv) > 4 else ''}'`.", ""]
for sheet in report["sheets"]:
    lines += [f"## Sheet `{sheet['name']}`: {sheet['rows']:,} rows, {len(sheet['columns'])} columns, {sheet['blank_rows_dropped']:,} blank row(s) dropped", ""]
    if any(sheet["preamble_rows"]):
        lines += ["Rows above the header, as printed:", ""] + [f"    {' | '.join(r)}" for r in sheet["preamble_rows"] if r] + [""]
    lines += ["| column | blank | distinct | forms | sample |", "|---|---|---|---|---|"]
    for c in sheet["columns"]:
        lines.append(f"| {tidy(c['name'])} | {c['blank']} | {c['distinct']} | {', '.join(f'{k} {v}' for k, v in c['forms'].items())} | {' / '.join(tidy(s)[:40] for s in c['sample'])} |")
    lines.append("")
(out / "SCHEMA.md").write_text("\n".join(lines) + "\n")
print(f"{len(report['sheets'])} sheet(s) -> archives/{name}/")
PY3
fi
[[ "$name" == "tec-register" ]] || { echo "unknown archive $name" >&2; exit 1; }
mkdir -p "archives/$name"
exec uv run --group registers python - "$name" <<'PY'
import json, sys
from pathlib import Path
from grid_mysteries.evidence import write_json
from grid_mysteries.sources import tec_register as tr

name = sys.argv[1]
root = Path(".")
vintages, skipped = tr.load_vintages(root / tr.JOURNAL_PATH, root)
report = tr.schema_report(vintages, skipped)
out = root / "archives" / name
write_json(out / "schema-report.json", report)
lines = [
    f"# Schema report: NESO TEC Register archive",
    "",
    f"Regenerated by `scripts/schema-report {name}`; `schema-report.json` beside this file has every copy. "
    f"{report['copies']} copies parsed, {len(report['unparseable'])} unparseable.",
    "",
    "## Eras (one column vocabulary each)",
    "",
    "| first | last | copies | columns |",
    "|---|---|---|---|",
]
for e in report["eras"]:
    lines.append(f"| {e['first']} | {e['last']} | {e['copies']} | {', '.join(e['columns'])} |")
lines += ["", "## Date spellings in the effective-from column (cells, all copies)", ""]
lines += [f"- {k}: {v:,}" for k, v in report["date_spelling_totals"].items()]
latest = report["per_copy"][-1] if report["per_copy"] else {"t_public": "-"}
for column, key in tr.VOCABULARY_COLUMNS:
    lines += ["", f"## {column}, every spelling printed (cells, all copies)", ""]
    lines += [f"| {column} as printed | cells, all copies | cells in the latest copy |", "|---|---|---|"]
    for k, v in report[f"{key}_totals"].items():
        lines.append(f"| {k or '(blank)'} | {v:,} | {latest.get(key, {}).get(k, 0):,} |")
lines += ["", f"The latest column above is the copy of {latest['t_public']}."]
lines += ["", f"## Flagged copies ({len(report['flagged'])})", ""]
for f in report["flagged"]:
    lines.append(f"- {f['t_public']}: " + "; ".join(f["flags"]))
lines += ["", "## Unparseable copies", ""]
lines += [f"- {s['t_public']}: {s['error']}" for s in report["unparseable"]] or ["- none"]
(out / "SCHEMA.md").write_text("\n".join(lines) + "\n")
print(f"{report['copies']} copies, {len(report['eras'])} eras, {len(report['flagged'])} flagged -> archives/{name}/")
PY
